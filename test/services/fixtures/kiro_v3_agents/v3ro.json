{
  "name": "v3ro",
  "description": "KV3 v3-shape read-only agent",
  "prompt": "You are a KV3 probe agent for a CAO compatibility test. Answer briefly.",
  "tools": [
    "read_file",
    "list_directory",
    "file_search",
    "grep_search",
    "@cao-mcp-server"
  ],
  "excludedTools": [],
  "includeMcpJson": false,
  "includePowers": false,
  "resources": [],
  "mcpServers": {
    "cao-mcp-server": {
      "command": "cao-mcp-server",
      "args": [],
      "timeout": 1200000
    }
  },
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "effect": "deny"
      },
      {
        "capability": "web_search",
        "effect": "deny"
      },
      {
        "capability": "subagent",
        "effect": "deny"
      }
    ]
  }
}

{
  "name": "reviewer",
  "description": "Code Reviewer Agent in a multi-agent system",
  "tools": [
    "@cao-mcp-server",
    "fs_read",
    "glob",
    "goal",
    "grep",
    "introspect",
    "knowledge",
    "read",
    "todo_list"
  ],
  "allowedTools": [
    "@builtin",
    "fs_read",
    "fs_list",
    "@cao-mcp-server"
  ],
  "includeMcpJson": false,
  "resources": [
    "file://<ROOT>/agent-context/reviewer.md",
    "skill://<ROOT>/skills/**/SKILL.md",
    "skill://<ROOT>/skills/*/SKILL.md"
  ],
  "mcpServers": {
    "cao-mcp-server": {
      "type": "stdio",
      "command": "/fixture/bin/cao-mcp-server",
      "args": [],
      "timeout": 1200000
    }
  }
}
#!/usr/bin/env python3
"""Provider lifecycle hook: report a terminal status to CAO."""
import os
import sys
import urllib.parse
import urllib.request

terminal_id = os.environ.get("CAO_TERMINAL_ID", "")
status = (sys.argv[1] if len(sys.argv) > 1 else "").strip().lower()
if not terminal_id or status not in {"idle", "processing", "completed", "waiting_user_answer", "error"}:
    raise SystemExit(2)
base = os.environ.get("CAO_API_URL", "http://127.0.0.1:9889").rstrip("/")
url = f"{base}/terminals/{urllib.parse.quote(terminal_id)}/status?reported_status={urllib.parse.quote(status)}"
request = urllib.request.Request(url, method="POST")
token = os.environ.get("CAO_AUTH_TOKEN")
if token:
    request.add_header("Authorization", f"Bearer {token}")
with urllib.request.urlopen(request, timeout=5):
    pass

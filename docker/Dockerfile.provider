# Provider layer: add an authenticated Kiro CLI on top of the provider-free CAO
# node image. This is the layering pattern docker/Dockerfile documents.
#
# WHY A SEPARATE FILE rather than a COPY in the base Dockerfile:
#   - The Kiro CLI install tree is ~800 MB and is NOT redistributable in this
#     repo, so it must not be committed. Keeping it out of the base build
#     context also keeps the base image buildable by anyone (mock_cli only, no
#     credentials).
#   - Docker cannot COPY from outside the build context, and COPY is not
#     conditional, so an optional provider cannot live in the base Dockerfile.
#
# COPY THE WHOLE INSTALL DIRECTORY, AND PUT THE HELPERS ON PATH. `kiro-cli` is
# a launcher that execs sibling binaries: `kiro-cli chat` execs
# `kiro-cli-chat`, and shell integration uses `kiro-cli-term`. It resolves them
# through PATH (verified by strace: it tries /usr/local/bin, /usr/local/sbin,
# /usr/sbin, /usr/bin, /sbin, /bin in turn), NOT relative to its own location —
# so symlinking only `kiro-cli` into PATH is not enough.
#
# Shipping only `kiro-cli` produces a binary where `--version` and `--help`
# succeed but `chat --help` fails with the bare message
# "error: No such file or directory (os error 2)" — which surfaces in CAO as
# "Kiro capability probe for engine 'v2' returned unusable help output" (CAO
# probes `kiro-cli chat --help` to detect capabilities), i.e. a confusing
# CAO-side error for a packaging mistake. The smoke test below therefore
# exercises `chat --help`, not just `--version`.
#
# BUILD (the install dir must be the build context, since COPY is
# context-relative):
#   docker build -t cao-server:<tag> -f docker/Dockerfile .          # base
#   docker build -t cao-server:<tag>-kiro<ver> \
#     -f docker/Dockerfile.provider \
#     --build-arg BASE_IMAGE=cao-server:<tag> \
#     <kiro-cli-install-dir>                                        # provider
#
# <kiro-cli-install-dir> is the directory containing the kiro-cli, kiro-cli-chat
# and kiro-cli-term executables. See ../docs/kiro-cli.md for installation.
#
# The binaries are dynamically linked, so they must match the base image's libc
# (python:3.12-slim => Debian bookworm, glibc 2.36). The smoke test fails the
# BUILD rather than letting a mismatch surface as a runtime error in a pod.
ARG BASE_IMAGE=cao-server:latest
FROM ${BASE_IMAGE}

# Root only to install into /opt and /usr/local/bin; drops back to cao before
# the entrypoint. The base image's USER cao is inherited otherwise, and an
# unprivileged user cannot write there.
USER root

# Whole tree into /opt/kiro-cli, then every executable symlinked onto PATH so
# the launcher can exec its helpers (see the PATH note above).
COPY --chmod=755 . /opt/kiro-cli/
RUN set -eux; \
    rm -f /opt/kiro-cli/*_post_install_script; \
    for b in kiro-cli kiro-cli-chat kiro-cli-term; do \
        ln -sf "/opt/kiro-cli/$b" "/usr/local/bin/$b"; \
    done

# Fail the build on a broken/incompatible install (wrong arch, missing shared
# libs, missing sibling binary) instead of shipping an image whose provider
# cannot start. `chat --help` is the command CAO's capability probe runs.
RUN set -eux; \
    kiro-cli --version; \
    kiro-cli chat --help > /dev/null; \
    test -x /opt/kiro-cli/kiro-cli-chat

USER cao

FROM python:3.12-slim

RUN pip install --no-cache-dir \
    "fastapi>=0.104.0" \
    "kubernetes>=30.0.0,<35.0.0" \
    "requests>=2.32.0" \
    "uvicorn[standard]>=0.24.0"

WORKDIR /app
COPY examples/cao-clusters/kubernetes/eks/broker.py /app/broker.py

USER 65532:65532
EXPOSE 9890
CMD ["uvicorn", "broker:app", "--host", "0.0.0.0", "--port", "9890"]

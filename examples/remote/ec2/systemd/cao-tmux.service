# tmux is deliberately a separate unit. CAO uses tmux's standard per-user
# socket, and a cao-server restart must not kill the agents in that server.
# Do not add PrivateTmp: interactive `ssh -t ... tmux attach` must see it too.
[Unit]
Description=tmux server for CAO agents
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=@BOX_USER@
Group=@BOX_USER@
WorkingDirectory=@BOX_HOME@
Environment=HOME=@BOX_HOME@
Environment=USER=@BOX_USER@
Environment=PATH=@BOX_HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/tmux new-session -d -s cao-server
# tmux daemonizes. Keep its cgroup separate and never kill sessions on stop.
KillMode=none

[Install]
WantedBy=multi-user.target

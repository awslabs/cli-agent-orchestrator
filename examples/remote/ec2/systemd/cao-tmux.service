# tmux is deliberately a separate unit. CAO uses tmux's standard per-user
# socket, and a cao-server restart cannot kill the agents in this cgroup.
# Do not add PrivateTmp: interactive `ssh -t ... tmux attach` must see it too.
[Unit]
Description=tmux server for CAO agents
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=@BOX_USER@
Group=@BOX_USER@
WorkingDirectory=@BOX_HOME@
Environment=HOME=@BOX_HOME@
Environment=USER=@BOX_USER@
Environment=PATH=@BOX_HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/tmux new-session -d -s box-keepalive
ExecStartPost=/usr/bin/tmux set-option -s exit-empty off
# An explicit stop intentionally kills the server and its agent sessions.
ExecStop=/usr/bin/tmux kill-server

[Install]
WantedBy=multi-user.target

{
  "name": "cao-mcp-apps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MCP Apps (SEP-1865) UI surface for CLI Agent Orchestrator. Bundles to single-file HTML resources served via cao-mcp-server.",
  "scripts": {
    "postinstall": "patch-package --patch-dir ../patches --error-on-fail",
    "prepare": "cd .. && husky cao_mcp_apps/.husky || true",
    "scan:jit": "node scripts/scan-jit.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "coverage:ratchet": "node scripts/coverage-ratchet.mjs ..",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dependencies": "node --test scripts/dependency-security.cjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "build:dashboard": "vite build -c vite.config.dashboard.ts",
    "build:agent": "vite build -c vite.config.agent.ts",
    "build:events": "vite build -c vite.config.events.ts",
    "build:graph": "vite build -c vite.config.graph.ts",
    "prebuild:all": "npm run test:dependencies",
    "build:all": "npm run build:dashboard && npm run build:agent && npm run build:events && npm run build:graph",
    "demo": "node scripts/record-demo.mjs",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.py": [
      "uv run --project .. black --check",
      "uv run --project .. isort --check-only"
    ],
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --check"
    ]
  },
  "dependencies": {
    "@dieub/braces-depth-guard": "file:../vendor/dieub-braces-depth-guard-3.0.3-pn.3.tgz",
    "braces": "file:braces-compat",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "patch-package": "8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sigma": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.6",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "braces": "$braces",
    "nanoid": "^3.3.17"
  }
}

{
  "name": "cao-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package --patch-dir ../patches --error-on-fail",
    "dev": "vite",
    "prebuild": "npm run test:dependencies",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dependencies": "node --test scripts/dependency-security.cjs"
  },
  "dependencies": {
    "@dieub/braces-depth-guard": "file:../vendor/dieub-braces-depth-guard-3.0.3-pn.3.tgz",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "braces": "file:braces-compat",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "lucide-react": "^0.562.0",
    "patch-package": "8.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sigma": "^3.0.3",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "overrides": {
